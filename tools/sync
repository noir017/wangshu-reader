#!/usr/bin/env bash
# 本地源码 → oraclea2 的 moonreader-dev 容器（/work/moonreader-web）。单向，本地为准。
# 远端生成物（node_modules、dist、out、package-lock.json 等）被排除，既不推送也不会被 --delete 删掉。
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
exec rsync -az --delete \
  --exclude '.git/' \
  --exclude 'node_modules/' --exclude 'dist/' --exclude 'dist-single/' --exclude 'dist-server/' \
  --exclude 'out/' --exclude 'coverage/' \
  --exclude '.vite/' --exclude 'test-results/' --exclude 'playwright-report/' \
  --exclude '*.tsbuildinfo' --exclude 'package-lock.json' \
  --exclude '/server/data/' --exclude '/samples/' \
  "$here/" oraclea2:apps/moonreader-dev/workspace/moonreader-web/
