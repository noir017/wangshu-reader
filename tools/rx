#!/usr/bin/env bash
# 在 armbox 的 moonreader-dev 容器里执行 shell 命令（默认先 tools/sync 推一次源码）。
# 用法：tools/rx [--no-sync] [-C <相对 /work/moonreader-web 的目录>] '<命令>'
#   tools/rx 'npm run typecheck'
#   tools/rx --no-sync -C /work/analysis 'grep -rl tts jadx/sources | head'   # -C 以 / 开头则为容器内绝对路径
# 命令经 stdin 交给容器内 bash -l，不用再套一层引号。
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
sync=1; dir=/work/moonreader-web
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-sync) sync=0; shift ;;
    -C) [[ "$2" == /* ]] && dir="$2" || dir="/work/moonreader-web/$2"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[[ $# -gt 0 ]] || { echo "用法: tools/rx [--no-sync] [-C dir] '<命令>'" >&2; exit 2; }
[[ $sync == 1 ]] && "$here/tools/sync" >&2
ssh armbox "docker exec -i -w '$dir' moonreader-dev bash -l" <<<"$*"
