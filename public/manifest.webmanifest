{
  "id": "./",
  "name": "静读天下 Web",
  "short_name": "静读天下",
  "description": "静读天下（Moon+ Reader）的网页版：书架、阅读器、网络书库、云同步",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#2d2d2d",
  "theme_color": "#1e88e5",
  "categories": ["books", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "我的书架", "short_name": "书架", "url": "./#/shelf", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "网上书库", "short_name": "书库", "url": "./#/net", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "我的文件", "short_name": "文件", "url": "./#/files", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/epub+zip": [".epub", ".epub3"],
        "application/pdf": [".pdf"],
        "text/plain": [".txt"],
        "application/x-mobipocket-ebook": [".mobi", ".azw", ".azw3", ".prc"],
        "application/x-fictionbook+xml": [".fb2"],
        "application/vnd.comicbook+zip": [".cbz"],
        "application/vnd.comicbook-rar": [".cbr"],
        "application/vnd.ms-htmlhelp": [".chm"],
        "image/vnd.djvu": [".djvu"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.oasis.opendocument.text": [".odt"],
        "application/rtf": [".rtf"],
        "text/markdown": [".md"],
        "text/html": [".html", ".htm"],
        "application/zip": [".zip"]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/epub+zip", "application/pdf", "text/plain", "application/x-mobipocket-ebook", "application/x-fictionbook+xml",
            "application/vnd.comicbook+zip", "application/vnd.ms-htmlhelp", "image/vnd.djvu", "application/zip", "text/markdown", "text/html",
            ".epub", ".pdf", ".txt", ".mobi", ".azw3", ".fb2", ".cbz", ".cbr", ".chm", ".djvu", ".docx", ".zip", ".md"
          ]
        }
      ]
    }
  }
}
